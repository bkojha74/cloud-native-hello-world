# Server Configuration
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10

# MongoDB Configuration
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hello_world?retryWrites=true&w=majority
# For local Docker MongoDB:
# MONGO_URI=mongodb://mongodb:27017
MONGO_DB=hello_world
MONGO_URI=mongodb+srv://<username>:<password>@taskmanagercluster.jwtpwgc.mongodb.net/hello_world?retryWrites=true&w=majority

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300
